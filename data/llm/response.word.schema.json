{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lens word explanation response",
  "description": "The object the model is asked to return inside choices[0].message.content. Validation reads this file for the required field list, so the code and API.md cannot drift apart.",
  "type": "object",
  "required": ["results"],
  "properties": {
    "results": {
      "type": "array",
      "description": "One entry per requested word, echoed in any order.",
      "items": {
        "type": "object",
        "required": ["word"],
        "anyOf": [{"required": ["en", "zh"]}, {"required": ["senses"]}],
        "properties": {
          "word": { "type": "string", "minLength": 1, "description": "The input word, spelled exactly as requested." },
          "ipa": { "type": "string", "description": "IPA pronunciation, in slashes." },
          "en": { "type": "string", "minLength": 1, "description": "One-line English definition." },
          "zh": { "type": "string", "minLength": 1, "description": "One-line Chinese definition." },
          "translation": { "type": "string", "minLength": 1 },
          "senses": {
            "type": "array",
            "minItems": 1,
            "description": "Distinct senses in descending frequency order; Lens retains at most three.",
            "items": {
              "type": "object",
              "required": ["en", "zh"],
              "properties": {
                "en": { "type": "string", "minLength": 1 },
                "zh": { "type": "string", "minLength": 1 },
                "translation": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    }
  }
}
