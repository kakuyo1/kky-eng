build/
build-*/
CMakeCache.txt
*.user
node_modules/

# Test run records: local snapshots, regenerated by hand when a run is worth keeping
test/records/

# API and settings
settings.local.json

# This machine's paths, overriding config/paths.json. The tracked file carries the values the
# repository was set up with; another machine overrides the ones that differ here.
config/paths.local.json

# Runtime logs: keep the directory, ignore its contents
logs/*
!logs/.gitkeep

# Translations: the .ts files are the source, the .qm files are built from them
i18n/*.qm

# Per-branch checkouts the agent harness creates under .claude/. They are working copies of this
# repository, so an unignored one shows up as an untracked tree and can be staged whole by a
# `git add -A`; the branches they carry are the thing to keep, not the directories.
.claude/worktrees/

# The /team workflow's handover documents (PLAN/IMPLEMENTATION/REVIEW, watcher state). They live
# inside the checkout but belong to no commit; ignoring them keeps `git status` clean.
.orca/

# Per-machine notes for the assistant. Personal to one machine;
CLAUDE.local.md

# Art this project no longer ships: the Undertale-derived dog, kept on this machine only. The shipped dog is
# original (PHASE3 3.1). It stays out of the repository and out of the installer, which reads data/ only.
assets-private/
